        "class MoE(nn.Module):\n",
        "    def __init__(\n",
        "        self,\n",
        "        n_embd: int,\n",
        "        dropout: float,\n",
        "        num_experts: int,\n",
        "        top_k: int,\n",
        "        capacity_factor: float,\n",
        "    ):\n",
        "        super().__init__()\n",
        "        self.num_experts = num_experts\n",
        "        self.top_k = top_k\n",
        "        self.capacity_factor = capacity_factor\n",
        "\n",
        "        # 1. The Router: maps embedding dim to num_experts\n",
        "        self.router = nn.Linear(n_embd, num_experts, bias=False)\n",
        "\n",
        "        # 2. DeepSeek-style Fine-Grained Experts\n",
        "        # A standard FFN hidden dim is usually 4 * n_embd.\n",
        "        # To maintain parameter count while doubling experts, we halve the hidden dim to 2 * n_embd.\n",
        "        exp_hid_dim = 2 * n_embd\n",
        "        self.experts = nn.ModuleList([\n",
        "            FeedForward(n_embd, exp_hid_dim, dropout) for _ in range(num_experts)\n",
        "        ])\n",
        "\n",
        "    def forward(self, x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:\n",
        "        B, T, C = x.shape\n",
        "\n",
        "        # Flatten sequence and batch for easier routing: (B*T, C)\n",
        "        x_flat = x.view(-1, C)\n",
        "        total_tokens = B * T\n",
        "\n",
        "        # 1. Capacity Calculation\n",
        "        capacity = int((total_tokens * self.top_k / self.num_experts) * self.capacity_factor)\n",
        "\n",
        "        # 2. Routing Logic\n",
        "        logits = self.router(x_flat) # (B*T, num_experts)\n",
        "        routing_weights = F.softmax(logits, dim=-1) # (B*T, num_experts)\n",
        "\n",
        "        # Find Top-K experts per token\n",
        "        top_k_weights, top_k_indices = torch.topk(routing_weights, self.top_k, dim=-1) # Both are (B*T, top_k)\n",
        "\n",
        "        # Normalize the Top-K weights so they sum to 1.0 for each token!\n",
        "        # (Adding a tiny epsilon 1e-9 to prevent division by zero, preventing NaNs)\n",
        "        top_k_weights = top_k_weights / (top_k_weights.sum(dim=-1, keepdim=True) + 1e-9)\n",
        "\n",
        "        # 3. Dispatch & Token Dropping\n",
        "        out_flat = torch.zeros_like(x_flat)\n",
        "        total_dropped_tokens = 0\n",
        "\n",
        "        # Iterate through every expert\n",
        "        for i in range(self.num_experts):\n",
        "            # Find where this expert 'i' is within the top_k_indices\n",
        "            # mask is boolean: (B*T, top_k)\n",
        "            mask = (top_k_indices == i)\n",
        "\n",
        "            # Extract the absolute token index (0 to B*T-1) and the rank index (0 to top_k-1)\n",
        "            token_idx, k_idx = mask.nonzero(as_tuple=True)\n",
        "\n",
        "            num_assigned = token_idx.size(0)\n",
        "            if num_assigned == 0:\n",
        "                continue # No tokens routed to this expert\n",
        "\n",
        "            # Token Dropping (Capacity Enforcement)\n",
        "            if num_assigned > capacity:\n",
        "                total_dropped_tokens += (num_assigned - capacity)\n",
        "                token_idx = token_idx[:capacity] # Truncate excess\n",
        "                k_idx = k_idx[:capacity]\n",
        "\n",
        "            # Extract valid tokens\n",
        "            expert_in = x_flat[token_idx]\n",
        "\n",
        "            # Pass through the specific expert\n",
        "            expert_out = self.experts[i](expert_in)\n",
        "\n",
        "            # Multiply by the correct normalized routing weight\n",
        "            # We unsqueeze(-1) to broadcast (num_assigned, 1) against (num_assigned, C)\n",
        "            weights = top_k_weights[token_idx, k_idx].unsqueeze(-1)\n",
        "            expert_out = expert_out * weights\n",
        "\n",
        "            # Accumulate the results back into the output tensor\n",
        "            out_flat[token_idx] += expert_out\n",
        "\n",
        "        # 4. Calculate Drop Rate\n",
        "        drop_rate = total_dropped_tokens / (total_tokens * self.top_k)\n",
        "\n",
        "        # Reshape back to (B, T, C)\n",
        "        out = out_flat.view(B, T, C)\n",
        "\n",
        "        # Return output and drop rate as a scalar tensor\n",
        "        return out, torch.tensor(drop_rate, dtype=torch.float32, device=x.device)"
      ],
