        "class MultiHeadSelfAttentionRope(nn.Module):\n",
        "    \"\"\"Causal multi-head self-attention with RoPE\"\"\"\n",
        "    def __init__(self, n_embd: int, n_head: int, block_size: int, dropout: float):\n",
        "        super().__init__()\n",
        "        assert n_embd % n_head == 0\n",
        "\n",
        "        self.n_head = n_head\n",
        "        self.head_size = n_embd // n_head\n",
        "\n",
        "        # 1. Projections for Query, Key, and Value\n",
        "        self.q_proj = nn.Linear(n_embd, n_embd, bias=False)\n",
        "        self.k_proj = nn.Linear(n_embd, n_embd, bias=False)\n",
        "        self.v_proj = nn.Linear(n_embd, n_embd, bias=False)\n",
        "\n",
        "        # 2. Output projection\n",
        "        self.c_proj = nn.Linear(n_embd, n_embd, bias=False)\n",
        "\n",
        "        # 3. Regularization\n",
        "        self.attn_dropout = nn.Dropout(dropout)\n",
        "        self.resid_dropout = nn.Dropout(dropout)\n",
        "\n",
        "        # 4. RoPE Initialization\n",
        "        self.rope = RoPE(self.head_size, max_seq_len=block_size)\n",
        "\n",
        "        # 5. Causal Mask (lower triangular matrix)\n",
        "        # We register this as a buffer so PyTorch handles device placement automatically\n",
        "        mask = torch.tril(torch.ones(block_size, block_size)).view(1, 1, block_size, block_size)\n",
        "        self.register_buffer(\"bias\", mask)\n",
        "\n",
        "    def forward(self, x: torch.Tensor) -> torch.Tensor:\n",
        "        B, T, C = x.size() # Batch size, Sequence length, Embedding dimension\n",
        "\n",
        "        # 1. Linear projections\n",
        "        # Shape becomes: (B, T, n_head, head_size), then we transpose to (B, n_head, T, head_size)\n",
        "        q = self.q_proj(x).view(B, T, self.n_head, self.head_size).transpose(1, 2)\n",
        "        k = self.k_proj(x).view(B, T, self.n_head, self.head_size).transpose(1, 2)\n",
        "        v = self.v_proj(x).view(B, T, self.n_head, self.head_size).transpose(1, 2)\n",
        "\n",
        "        # 2. Apply RoPE to Query and Key tensors BEFORE attention\n",
        "        q, k = self.rope(q, k)\n",
        "\n",
        "        # 3. Calculate Attention Scores (q * k^T) / sqrt(d_k)\n",
        "        # k.transpose(-2, -1) flips the last two dimensions to match matrix multiplication rules\n",
        "        att = (q @ k.transpose(-2, -1)) * (1.0 / math.sqrt(self.head_size))\n",
        "\n",
        "        # 4. Apply the causal mask\n",
        "        # We slice self.bias[:, :, :T, :T] just in case the sequence T is smaller than block_size\n",
        "        att = att.masked_fill(self.bias[:, :, :T, :T] == 0, float('-inf'))\n",
        "\n",
        "        # 5. Softmax & Dropout\n",
        "        att = F.softmax(att, dim=-1)\n",
        "        att = self.attn_dropout(att)\n",
        "\n",
        "        # 6. Matrix multiply with Values\n",
        "        y = att @ v # (B, n_head, T, T) x (B, n_head, T, head_size) -> (B, n_head, T, head_size)\n",
        "\n",
        "        # 7. Re-assemble all head outputs side by side\n",
        "        y = y.transpose(1, 2).contiguous().view(B, T, C)\n",
        "\n",
        "        # 8. Output projection and residual dropout\n",
        "        out = self.resid_dropout(self.c_proj(y))\n",
        "\n",
        "        return out"
      ],
